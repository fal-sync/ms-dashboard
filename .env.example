# Application
APP_NAME=clean-architecture-boilerplate
APP_PORT=8080
APP_SHUTDOWN_TIMEOUT=10s

# External HTTP service integration (user sync hook)
# Leave EXTERNAL_USER_SYNC_BASE_URL empty to disable this hook.
EXTERNAL_USER_SYNC_BASE_URL=http://localhost:9000
EXTERNAL_USER_SYNC_PATH=/internal/users/sync
EXTERNAL_USER_SYNC_TIMEOUT=3s

# Kafka (event publishing)
# Set KAFKA_ENABLED=true and provide at least one broker to enable publishing.
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_USER_CREATED_TOPIC=user.created
